# SERVER ONLY: add in Vercel Project Settings → Environment Variables, then redeploy.
# Never use VITE_ prefixes for these values. Never commit .env.local.
FAHM_AI_API_KEY=
# Quality-first default; your API account must have access. Override as needed.
FAHM_AI_MODEL=gpt-6-astra
# An access password you create, NOT another API key.
# Use the generator in AI Studio or: openssl rand -hex 32
# Enter the same access token in AI Studio, not the provider API key.
FAHM_REVIEW_TOKEN=
